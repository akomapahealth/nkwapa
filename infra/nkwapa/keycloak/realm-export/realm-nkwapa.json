{
  "realm": "nkwapa",
  "enabled": true,
  "loginTheme": "nkwapa",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "verifyEmail": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and passwordHistory(5) and notUsername(undefined)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "actionTokenGeneratedByUserLifespan": 900,
  "attributes": {
    "actionTokenGeneratedByUserLifespan.reset-credentials": "900",
    "actionTokenGeneratedByUserLifespan.verify-email": "86400"
  },
  "defaultRoles": ["uma_authorization", "offline_access"],
  "roles": {
    "realm": [
      {
        "name": "SYSTEM_ADMIN",
        "description": "Global admin"
      },
      {
        "name": "DIRECTOR",
        "description": "Clinic director"
      },
      {
        "name": "MANAGER",
        "description": "Clinic manager"
      },
      {
        "name": "DOCTOR",
        "description": "Doctor"
      },
      {
        "name": "PRECEPTOR",
        "description": "Preceptor"
      },
      {
        "name": "VOLUNTEER",
        "description": "Volunteer"
      },
      {
        "name": "PATIENT",
        "description": "Patient portal user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "nkwapa-web",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://app.nkwapa.app/*",
        "https://app.nkwapa.app",
        "https://staging.nkwapa.app/*",
        "https://staging.nkwapa.app",
        "http://localhost:3000/*",
        "http://localhost:3000"
      ],
      "webOrigins": [
        "https://app.nkwapa.app",
        "https://staging.nkwapa.app",
        "http://localhost:3000"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://app.nkwapa.app/*##https://app.nkwapa.app##https://staging.nkwapa.app/*##https://staging.nkwapa.app##http://localhost:3000/*##http://localhost:3000"
      },
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "users": []
}
