# .env.example (repo root)
# Staging and production templates live in deploy/env/.

# Postgres (docker)
POSTGRES_DB=nkwapa
POSTGRES_USER=nkwapa
POSTGRES_PASSWORD=nkwapa

# For Prisma (API will use this too)
# Owner credential. Runs migrations and owns the tables.
DATABASE_URL=postgresql://nkwapa:nkwapa@localhost:5433/nkwapa
# Runtime credential. Unprivileged, so Postgres row level security actually applies to it.
# Provision it with: node scripts/provision-app-db-role.mjs
# Falls back to DATABASE_URL when unset, in which case the policies are NOT enforced.
APP_DATABASE_URL=postgresql://nkwapa_app:nkwapa_app@localhost:5433/nkwapa
APP_DATABASE_PASSWORD=nkwapa_app
# Set to `required` to refuse to start against a database that cannot enforce isolation.
DATABASE_RLS_ENFORCEMENT=warn

# Redis (required for reminder queue)
REDIS_URL=redis://localhost:6379

# API hardening
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://staging.nkwapa.app,https://app.nkwapa.app
RATE_LIMIT_AUTH_ME_LIMIT=120
RATE_LIMIT_AUTH_ME_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_WHOAMI_LIMIT=60
RATE_LIMIT_AUTH_WHOAMI_WINDOW_SECONDS=60
RATE_LIMIT_SYNC_PUSH_LIMIT=30
RATE_LIMIT_SYNC_PUSH_WINDOW_SECONDS=60
RATE_LIMIT_SYNC_PULL_LIMIT=60
RATE_LIMIT_SYNC_PULL_WINDOW_SECONDS=60
RATE_LIMIT_TWILIO_WEBHOOK_LIMIT=120
RATE_LIMIT_TWILIO_WEBHOOK_WINDOW_SECONDS=60
RATE_LIMIT_CLAIM_RECORD_LIMIT=10
RATE_LIMIT_CLAIM_RECORD_WINDOW_SECONDS=600
RATE_LIMIT_PATIENT_PORTAL_MEASUREMENT_WRITE_LIMIT=20
RATE_LIMIT_PATIENT_PORTAL_MEASUREMENT_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_PATIENT_PORTAL_APPOINTMENT_REQUEST_WRITE_LIMIT=10
RATE_LIMIT_PATIENT_PORTAL_APPOINTMENT_REQUEST_WRITE_WINDOW_SECONDS=300

# Feature flags default to disabled. Public web flags must never replace API enforcement.
FEATURE_MEDICAL_HISTORY_ENABLED=false
NEXT_PUBLIC_FEATURE_MEDICAL_HISTORY_ENABLED=false

# Email delivery (application mail: portal invites, reminders, lifecycle notices).
# This is NOT Keycloak's SMTP. Keycloak sends verify-email and password resets using the
# separate KC_SMTP_* settings on the Keycloak service; the two are configured independently.
# "fake" (default) logs message sizes instead of sending. "nodemailer" sends over SMTP.
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
# Credentials are optional, but only as a pair. Leave both blank for an unauthenticated
# relay such as the local Mailpit; setting only one is reported as a misconfiguration.
SMTP_USER=
SMTP_PASS=
# Implicit TLS is assumed on port 465 and STARTTLS elsewhere. Set to override.
SMTP_SECURE=
EMAIL_FROM=info@akomapa.org
EMAIL_REPLY_TO=
# Absolute origin used to build links in outbound mail. Links are omitted when unset.
APP_PUBLIC_URL=http://localhost:3000

# For local SMTP end to end, point the app at the Mailpit in infra/nkwapa/docker-compose.yml:
#   EMAIL_PROVIDER=nodemailer
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# Leave SMTP_USER and SMTP_PASS blank; Mailpit accepts unauthenticated mail.
# Read the resulting inbox at http://localhost:8025.

# SMS provider: fake (logs only) or twilio (future)
SMS_PROVIDER=fake

# Keycloak local
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nkwapa
KEYCLOAK_CLIENT_ID=nkwapa-web
KEYCLOAK_CLIENT_SECRET=replace_me_if_confidential_client
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# Keycloak SMTP for local password resets. docker-compose includes Mailpit:
# SMTP host is mailpit from inside Docker; inbox UI is http://localhost:8025.
KC_SMTP_HOST=mailpit
KC_SMTP_PORT=1025
KC_SMTP_FROM=no-reply@nkwapa.local
KC_SMTP_FROM_DISPLAY_NAME=Nkwapa
KC_SMTP_REPLY_TO=support@nkwapa.local
KC_SMTP_REPLY_TO_DISPLAY_NAME=Nkwapa Support
KC_SMTP_ENVELOPE_FROM=no-reply@nkwapa.local
KC_SMTP_AUTH=false
KC_SMTP_STARTTLS=false
KC_SMTP_SSL=false
KC_SMTP_USER=
KC_SMTP_PASSWORD=

# Seed (packages/db)
SEED_ORGANIZATION_NAME=Nkwapa Health
SEED_ORGANIZATION_SLUG=default
SEED_ORGANIZATION_TIMEZONE=Africa/Accra
SEED_CLINIC_NAME=Nkwapa Clinic - Demo
SEED_CLINIC_REGION=Greater Accra
SEED_CLINIC_COUNTRY=GH
SEED_CLINIC_TIMEZONE=Africa/Accra
SEED_CLINIC_LOCATION_CODE=nkwapa-clinic-demo
SEED_CLINIC_ZONE_CODE=
# Keycloak user sub for SYSTEM_ADMIN; obtain from JWT or Admin → Users → ID
SEED_SYSTEM_ADMIN_SUB=
SEED_SYSTEM_ADMIN_NAME=System Admin
SEED_SAMPLE_PATIENT=false

# Encryption / hashing (APP LAYER)
PII_ENCRYPTION_KEY_BASE64=
# Pepper for national ID hash (optional; improves dedup security)
NATIONAL_ID_PEPPER=
# 32-byte hex for national ID encryption (generate: openssl rand -hex 32)
NATIONAL_ID_ENCRYPTION_KEY=

# Research exports
RESEARCH_HMAC_KEY=
RESEARCH_HMAC_KEY_ID=research-hmac-v1
RESEARCH_EXPORT_DIR=./data/research-exports
RESEARCH_EXPORT_RETENTION_DAYS=30
RESEARCH_GITHUB_REPO_OWNER=
RESEARCH_GITHUB_REPO_NAME=
RESEARCH_GITHUB_REPO_BRANCH=main
RESEARCH_GITHUB_REPO_BASE_PATH=clinics
RESEARCH_GITHUB_TOKEN=
RESEARCH_GITHUB_MAX_FILE_BYTES=99614720
RESEARCH_GITHUB_MAX_TOTAL_BYTES=262144000
