// packages/db/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Sex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

// Ghana's 16 administrative regions. Used for a patient's residential
// location, which is deliberately kept separate from their primary clinic.
enum GhanaRegion {
  AHAFO
  ASHANTI
  BONO
  BONO_EAST
  CENTRAL
  EASTERN
  GREATER_ACCRA
  NORTH_EAST
  NORTHERN
  OTI
  SAVANNAH
  UPPER_EAST
  UPPER_WEST
  VOLTA
  WESTERN
  WESTERN_NORTH
}

// Deliberate capture state for a patient's residential location so that a
// missing location is never ambiguous blank text.
// - RECORDED: staff captured a residential location (region required).
// - UNKNOWN: staff asked but the location is not known.
// - NOT_RECORDED: never captured (default for migrated/new patients).
enum PatientLocationStatus {
  RECORDED
  UNKNOWN
  NOT_RECORDED
}

enum UserRole {
  SYSTEM_ADMIN
  DIRECTOR
  MANAGER
  DOCTOR
  VOLUNTEER
  PATIENT
}

enum ConsentType {
  RESEARCH_DEIDENTIFIED
}

enum ConsentStatus {
  GRANTED
  REVOKED
}

enum EncounterStatus {
  DRAFT
  IN_REVIEW
  FINALIZED
}

enum ClinicalNoteStatus {
  DRAFT
  PENDING_COSIGN
  COSIGNED
  AMENDED
}

enum ShiftStatus {
  ACTIVE
  CLOSED
}

enum ShiftRole {
  VOLUNTEER
  DOCTOR
  MANAGER
}

enum CheckInSource {
  STAFF
  PATIENT_SELF
}

enum CheckInStatus {
  WAITING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  REASSIGNED
  CANCELLED
}

enum GlucoseType {
  FASTING
  RANDOM
  UNKNOWN
}

enum DiabetesSymptom {
  POLYURIA
  POLYDIPSIA
  WEIGHT_LOSS
  BLURRED_VISION
  FATIGUE
}

enum PatientSelfReportType {
  FOLLOW_UP_UPDATE
  HOME_BP
  HOME_GLUCOSE
  SYMPTOMS
  GENERAL
}

enum PatientMeasurementSource {
  PATIENT
  STAFF
}

enum PatientMeasurementType {
  BP
  GLUCOSE
  WEIGHT
}

enum AppointmentRequestStatus {
  REQUESTED
  TRIAGED
  CONFIRMED
  REJECTED
  CANCELLED
}

enum AppointmentRequestType {
  NEW_APPOINTMENT
  CANCEL_APPOINTMENT
  RESCHEDULE_APPOINTMENT
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PatientPortalInviteStatus {
  PENDING
  CLAIMED
  CANCELLED
  EXPIRED
}

enum PatientDuplicateReviewStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

enum HypertensionClassification {
  NORMAL
  ELEVATED
  STAGE1
  STAGE2
  CRISIS
  UNKNOWN
}

enum ReminderChannel {
  SMS
  EMAIL
}

enum ReminderRecipientType {
  PATIENT
  USER
}

enum ReminderStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
}

enum ResearchExportStatus {
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum NationalIdType {
  VOTER_ID
  NATIONAL_ID
  PASSPORT
  OTHER
}

enum ConversationType {
  DIRECT
  GROUP
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum SyncOperation {
  UPSERT
  DELETE
}

enum SyncMutationStatus {
  APPLIED
  CONFLICT
  ERROR
}

enum MedicalHistoryCategory {
  CONDITION
  ALLERGY
  SURGERY_PROCEDURE
  FAMILY_HISTORY
  SOCIAL_HISTORY
}

enum MedicalHistoryStatus {
  ACTIVE
  RESOLVED
  INACTIVE
  HISTORICAL
  ENTERED_IN_ERROR
}

enum PatientMedicationStatus {
  CURRENT
  PAST
  STOPPED
}

enum MedicationSourceType {
  PATIENT_REPORTED
  CAREGIVER_REPORTED
  CLINIC_RECORD
  EXTERNAL_DOCUMENT
  MEDICATION_CONTAINER
  OTHER
}

enum MedicationReconciliationOutcome {
  CURRENT_LIST_REVIEWED
  NO_KNOWN_CURRENT_MEDICATIONS
}

enum BloodPressureSite {
  LEFT_ARM
  RIGHT_ARM
  LEFT_LEG
  RIGHT_LEG
  OTHER
}

enum PatientPosition {
  SITTING
  STANDING
  SUPINE
  OTHER
}

enum BloodPressureCuffSize {
  INFANT
  CHILD
  SMALL_ADULT
  ADULT
  LARGE_ADULT
  THIGH
  OTHER
}

enum TemperatureSource {
  ORAL
  AXILLARY
  TYMPANIC
  TEMPORAL
  RECTAL
  OTHER
}

enum TobaccoUseStatus {
  NOT_ASSESSED
  NEVER
  FORMER
  CURRENT
}

enum ScreeningAnswer {
  NOT_ASSESSED
  NO
  YES
}

enum ReadinessToQuit {
  NOT_ASSESSED
  NOT_READY
  CONSIDERING
  READY
  NOT_APPLICABLE
}

model Organization {
  id       String @id @default(uuid()) @db.Uuid
  name     String
  slug     String @unique @db.VarChar(120)
  timezone String @default("Africa/Accra") @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics Clinic[]
}

model Clinic {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  region         String?
  countryCode    String  @default("GH") @db.VarChar(2) // ISO-3166 alpha-2, v1 default GH
  timezone       String  @default("Africa/Accra") @db.VarChar(64)
  locationCode   String  @db.VarChar(64)
  zoneCode       String? @db.VarChar(64)
  isActive       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  organization              Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles                 UserClinicRole[]
  patients                  Patient[]                       @relation("PrimaryClinicPatients")
  encounters                Encounter[]
  consents                  PatientConsent[]
  reminders                 Reminder[]
  researchSettings          ClinicResearchSettings?
  researchExports           ResearchExport[]
  auditEvents               AuditEvent[]
  syncMutations             SyncMutation[]
  vitals                    Vitals[]
  tobaccoScreenings         TobaccoScreening[]
  diabetesScreening         DiabetesScreening[]
  hypertensionAssessment    HypertensionAssessment[]
  carePlans                 CarePlan[]
  drugs                     Drug[]
  prescriptions             Prescription[]
  patientSelfReports        PatientSelfReport[]
  patientMeasurements       PatientMeasurement[]
  staffShifts               StaffShift[]
  patientCheckIns           PatientCheckIn[]
  patientAssignments        PatientAssignment[]
  appointmentRequests       AppointmentRequest[]
  appointments              Appointment[]
  patientPortalInvites      PatientPortalInvite[]
  conversations             Conversation[]
  chatMessages              Message[]
  medicalHistoryRecords     MedicalHistoryRecord[]
  medicationRecords         PatientMedicationRecord[]
  medicationReconciliations MedicationReconciliationEvent[]
  pharmacyRecords           PatientPharmacyRecord[]
  pharmacyPreferences       PatientPharmacyPreference[]
  clinicalNotes             ClinicalNote[]
  clinicalNoteAddenda       ClinicalNoteAddendum[]
  duplicateReviews          PatientDuplicateReview[]

  @@unique([organizationId, locationCode])
  @@index([organizationId])
  @@index([organizationId, zoneCode])
  @@index([organizationId, name])
  @@index([countryCode])
  @@index([isActive])
}

model User {
  id          String @id @default(uuid()) @db.Uuid
  keycloakSub String @unique @db.VarChar(255)

  displayName String
  firstName   String? @db.VarChar(120)
  lastName    String? @db.VarChar(120)
  email       String? @db.VarChar(320)
  phoneE164   String? @db.VarChar(32) // enforced E.164 in app layer

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  clinicRoles                   UserClinicRole[]
  portalPatient                 Patient?                        @relation("PatientPortalUser")
  createdPatients               Patient[]                       @relation("PatientCreatedBy")
  createdEncounters             Encounter[]                     @relation("EncounterCreatedBy")
  preceptorReviewedEncounters   Encounter[]                     @relation("EncounterPreceptorReviewedBy")
  doctorFinalizedEncounters     Encounter[]                     @relation("EncounterDoctorFinalizedBy")
  recordedConsents              PatientConsent[]                @relation("ConsentRecordedBy")
  updatedClinicResearchSettings ClinicResearchSettings[]        @relation("ResearchSettingsUpdatedBy")
  requestedResearchExports      ResearchExport[]                @relation("ResearchExportRequestedBy")
  approvedResearchExports       ResearchExport[]                @relation("ResearchExportApprovedBy")
  auditEvents                   AuditEvent[]                    @relation("AuditActor")
  prescriptions                 Prescription[]                  @relation("PrescriptionPrescribedBy")
  patientSelfReports            PatientSelfReport[]             @relation("PatientSelfReportSubmittedBy")
  triagedAppointmentRequests    AppointmentRequest[]            @relation("AppointmentRequestTriagedBy")
  staffShifts                   StaffShift[]
  volunteerAssignments          PatientAssignment[]             @relation("AssignmentVolunteer")
  doctorAssignments             PatientAssignment[]             @relation("AssignmentDoctor")
  createdAssignments            PatientAssignment[]             @relation("AssignmentAssignedBy")
  doctorAppointments            Appointment[]                   @relation("AppointmentAssignedDoctor")
  volunteerAppointments         Appointment[]                   @relation("AppointmentAssignedVolunteer")
  createdPatientPortalInvites   PatientPortalInvite[]           @relation("PatientPortalInviteCreatedBy")
  claimedPatientPortalInvites   PatientPortalInvite[]           @relation("PatientPortalInviteClaimedBy")
  mergedPatients                Patient[]                       @relation("PatientMergedBy")
  duplicateReviews              PatientDuplicateReview[]        @relation("PatientDuplicateReviewedBy")
  conversationParticipants      ConversationParticipant[]
  sentMessages                  Message[]                       @relation("MessageSender")
  authoredHistoryRevisions      MedicalHistoryRevision[]        @relation("MedicalHistoryRevisionAuthor")
  recordedMedicationRecords     PatientMedicationRecord[]       @relation("PatientMedicationRecordedBy")
  authoredMedicationRevisions   PatientMedicationRevision[]     @relation("PatientMedicationRevisionAuthor")
  reconciledMedicationRevisions PatientMedicationRevision[]     @relation("PatientMedicationRevisionReconciler")
  medicationReconciliations     MedicationReconciliationEvent[] @relation("MedicationReconciliationActor")
  recordedPharmacyRecords       PatientPharmacyRecord[]         @relation("PatientPharmacyRecordedBy")
  authoredPharmacyRevisions     PatientPharmacyRevision[]       @relation("PatientPharmacyRevisionAuthor")
  setPharmacyPreferences        PatientPharmacyPreference[]     @relation("PatientPharmacyPreferenceSetBy")
  endedPharmacyPreferences      PatientPharmacyPreference[]     @relation("PatientPharmacyPreferenceEndedBy")
  reviewedTobaccoScreenings     TobaccoScreening[]              @relation("TobaccoScreeningReviewedBy")
  authoredDiabetesScreenings    DiabetesScreening[]             @relation("DiabetesScreeningAuthoredBy")
  authoredClinicalNotes         ClinicalNote[]                  @relation("ClinicalNoteAuthor")
  submittedClinicalNotes        ClinicalNote[]                  @relation("ClinicalNoteSubmitter")
  cosignedClinicalNotes         ClinicalNote[]                  @relation("ClinicalNoteCosigner")
  assignedVolunteerNotes        ClinicalNote[]                  @relation("ClinicalNoteAssignedVolunteer")
  assignedDoctorNotes           ClinicalNote[]                  @relation("ClinicalNoteAssignedDoctor")
  authoredClinicalNoteAddenda   ClinicalNoteAddendum[]          @relation("ClinicalNoteAddendumAuthor")
  receivedNotifications         Reminder[]                      @relation("ReminderRecipient")

  @@index([isActive])
}

model UserClinicRole {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @db.Uuid
  clinicId String?  @db.Uuid // null means global scope (SYSTEM_ADMIN)
  role     UserRole

  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId, role])
  @@index([userId])
  @@index([clinicId])
  @@index([role])
}

model Patient {
  id              String @id @default(uuid()) @db.Uuid
  patientCode     String @unique @db.VarChar(32) // NKP-YYYY-######, generated by app
  primaryClinicId String @db.Uuid

  firstName String    @db.VarChar(120)
  lastName  String    @db.VarChar(120)
  dob       DateTime?
  sex       Sex       @default(UNKNOWN)

  phoneE164 String? @db.VarChar(32) // enforce E.164 in app layer
  email     String? @db.VarChar(320)

  nationalIdType       NationalIdType
  nationalIdCiphertext String // app-layer encryption output
  nationalIdHash       String         @unique @db.VarChar(128) // SHA-256 hex or base64url
  nationalIdLast4      String?        @db.VarChar(8)

  // Residential/community location. Distinct from primaryClinicId (care site)
  // and Clinic.locationCode. Privacy-conscious: no GPS/lat/long in v1.
  residentialLocationStatus PatientLocationStatus @default(NOT_RECORDED)
  residentialRegion         GhanaRegion?
  residentialDistrict       String?               @db.VarChar(120)
  residentialCommunity      String?               @db.VarChar(120)
  residentialAddressNote    String?               @db.VarChar(280)

  createdByUserId     String?   @db.Uuid
  portalUserId        String?   @unique @db.Uuid
  mergedIntoPatientId String?   @db.Uuid
  mergedAt            DateTime?
  mergedByUserId      String?   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relations
  primaryClinic             Clinic                          @relation("PrimaryClinicPatients", fields: [primaryClinicId], references: [id])
  createdBy                 User?                           @relation("PatientCreatedBy", fields: [createdByUserId], references: [id])
  portalUser                User?                           @relation("PatientPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  mergedIntoPatient         Patient?                        @relation("PatientMerge", fields: [mergedIntoPatientId], references: [id], onDelete: SetNull)
  mergedSourcePatients      Patient[]                       @relation("PatientMerge")
  mergedBy                  User?                           @relation("PatientMergedBy", fields: [mergedByUserId], references: [id], onDelete: SetNull)
  accountLink               PatientAccountLink?
  encounters                Encounter[]
  consents                  PatientConsent[]
  reminders                 Reminder[]
  selfReports               PatientSelfReport[]
  measurements              PatientMeasurement[]
  checkIns                  PatientCheckIn[]
  appointmentRequests       AppointmentRequest[]
  appointments              Appointment[]
  portalInvites             PatientPortalInvite[]
  codeAliases               PatientCodeAlias[]
  medicalHistoryRecords     MedicalHistoryRecord[]
  medicationRecords         PatientMedicationRecord[]
  medicationReconciliations MedicationReconciliationEvent[]
  pharmacyRecords           PatientPharmacyRecord[]
  pharmacyPreferences       PatientPharmacyPreference[]
  clinicalNotes             ClinicalNote[]
  duplicateReviewsAsA       PatientDuplicateReview[]        @relation("PatientDuplicateReviewA")
  duplicateReviewsAsB       PatientDuplicateReview[]        @relation("PatientDuplicateReviewB")

  @@index([primaryClinicId])
  @@index([portalUserId])
  @@index([mergedIntoPatientId])
  @@index([lastName, firstName])
  @@index([phoneE164])
  @@index([updatedAt])
  @@index([primaryClinicId, updatedAt, id])
  @@index([primaryClinicId, residentialRegion])
  @@index([primaryClinicId, residentialLocationStatus])
}

model PatientConsent {
  id        String @id @default(uuid()) @db.Uuid
  patientId String @db.Uuid
  clinicId  String @db.Uuid

  consentType ConsentType
  status      ConsentStatus

  consentVersion      String @db.VarChar(32) // e.g. "v1-en"
  consentTextSnapshot String @db.Text

  grantedAt DateTime
  revokedAt DateTime?

  recordedByUserId String @db.Uuid

  witnessName      String? @db.VarChar(200)
  witnessPhoneE164 String? @db.VarChar(32)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic     Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("ConsentRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([patientId])
  @@index([clinicId])
  @@index([patientId, clinicId, consentType])
  @@index([status])
  @@index([updatedAt])
}

model Encounter {
  id        String @id @default(uuid()) @db.Uuid
  clinicId  String @db.Uuid
  patientId String @db.Uuid

  status EncounterStatus @default(DRAFT)

  createdByUserId       String  @db.Uuid
  preceptorReviewedById String? @db.Uuid
  doctorFinalizedById   String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic  Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  createdBy           User  @relation("EncounterCreatedBy", fields: [createdByUserId], references: [id])
  preceptorReviewedBy User? @relation("EncounterPreceptorReviewedBy", fields: [preceptorReviewedById], references: [id])
  doctorFinalizedBy   User? @relation("EncounterDoctorFinalizedBy", fields: [doctorFinalizedById], references: [id])

  vitals                 Vitals?
  tobaccoScreening       TobaccoScreening?
  diabetesScreening      DiabetesScreening?
  hypertensionAssessment HypertensionAssessment?
  carePlan               CarePlan?
  patientCheckIn         PatientCheckIn?
  patientMeasurements    PatientMeasurement[]

  reminders                  Reminder[]
  prescriptions              Prescription[]
  sourcedHistoryRevisions    MedicalHistoryRevision[]        @relation("MedicalHistoryRevisionSourceEncounter")
  sourcedMedicationRevisions PatientMedicationRevision[]     @relation("PatientMedicationRevisionSourceEncounter")
  medicationReconciliations  MedicationReconciliationEvent[] @relation("MedicationReconciliationSourceEncounter")
  clinicalNote               ClinicalNote?

  @@index([clinicId, updatedAt])
  @@index([patientId, updatedAt])
  @@index([status])
}

model StaffShift {
  id           String      @id @default(uuid()) @db.Uuid
  clinicId     String      @db.Uuid
  userId       String      @db.Uuid
  roleAtShift  ShiftRole
  checkedInAt  DateTime
  checkedOutAt DateTime?
  status       ShiftStatus @default(ACTIVE)
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clinicId, status, checkedInAt])
  @@index([userId, checkedInAt])
}

model PatientCheckIn {
  id          String        @id @default(uuid()) @db.Uuid
  clinicId    String        @db.Uuid
  patientId   String        @db.Uuid
  checkedInAt DateTime
  source      CheckInSource @default(STAFF)
  status      CheckInStatus @default(WAITING)
  encounterId String?       @unique @db.Uuid
  notes       String?       @db.Text
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  clinic      Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter   Encounter?          @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  assignments PatientAssignment[]

  @@index([clinicId, status, checkedInAt])
  @@index([patientId, checkedInAt])
}

model PatientAssignment {
  id                  String           @id @default(uuid()) @db.Uuid
  clinicId            String           @db.Uuid
  patientCheckInId    String           @db.Uuid
  assignedVolunteerId String           @db.Uuid
  assignedDoctorId    String           @db.Uuid
  assignedByUserId    String           @db.Uuid
  assignedAt          DateTime
  status              AssignmentStatus @default(ACTIVE)
  reason              String?          @db.Text
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  clinic            Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patientCheckIn    PatientCheckIn @relation(fields: [patientCheckInId], references: [id], onDelete: Cascade)
  assignedVolunteer User           @relation("AssignmentVolunteer", fields: [assignedVolunteerId], references: [id], onDelete: Cascade)
  assignedDoctor    User           @relation("AssignmentDoctor", fields: [assignedDoctorId], references: [id], onDelete: Cascade)
  assignedBy        User           @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  clinicalNotes     ClinicalNote[]

  @@index([clinicId, status, assignedAt])
  @@index([patientCheckInId])
}

model ClinicalNote {
  id          String             @id @default(uuid()) @db.Uuid
  clinicId    String             @db.Uuid
  patientId   String             @db.Uuid
  encounterId String             @unique @db.Uuid
  status      ClinicalNoteStatus @default(DRAFT)
  version     Int                @default(1)

  history    String @default("") @db.Text
  assessment String @default("") @db.Text
  plan       String @default("") @db.Text

  signedHistory     String? @db.Text
  signedAssessment  String? @db.Text
  signedPlan        String? @db.Text
  signedContentHash String? @db.VarChar(64)

  authorUserId String   @db.Uuid
  authorRole   UserRole

  assignmentId                  String?   @db.Uuid
  assignedVolunteerId           String?   @db.Uuid
  assignedVolunteerNameSnapshot String?   @db.VarChar(200)
  assignedDoctorId              String?   @db.Uuid
  assignedDoctorNameSnapshot    String?   @db.VarChar(200)
  assignmentAssignedAtSnapshot  DateTime?

  submittedByUserId String?   @db.Uuid
  submittedAt       DateTime?
  cosignedByUserId  String?   @db.Uuid
  cosignedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic            Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient           Patient                @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter         Encounter              @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  author            User                   @relation("ClinicalNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  assignment        PatientAssignment?     @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  assignedVolunteer User?                  @relation("ClinicalNoteAssignedVolunteer", fields: [assignedVolunteerId], references: [id], onDelete: Restrict)
  assignedDoctor    User?                  @relation("ClinicalNoteAssignedDoctor", fields: [assignedDoctorId], references: [id], onDelete: Restrict)
  submittedBy       User?                  @relation("ClinicalNoteSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict)
  cosignedBy        User?                  @relation("ClinicalNoteCosigner", fields: [cosignedByUserId], references: [id], onDelete: Restrict)
  addenda           ClinicalNoteAddendum[]

  @@index([clinicId, patientId, createdAt])
  @@index([clinicId, status, assignedDoctorId, submittedAt])
  @@index([authorUserId, status, updatedAt])
  @@index([assignmentId])
}

model ClinicalNoteAddendum {
  id             String   @id @default(uuid()) @db.Uuid
  clinicId       String   @db.Uuid
  clinicalNoteId String   @db.Uuid
  authorUserId   String   @db.Uuid
  reason         String   @db.VarChar(500)
  content        String   @db.Text
  createdAt      DateTime @default(now())

  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  clinicalNote ClinicalNote @relation(fields: [clinicalNoteId], references: [id], onDelete: Restrict)
  author       User         @relation("ClinicalNoteAddendumAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([clinicalNoteId, createdAt])
  @@index([clinicId, createdAt])
  @@index([authorUserId, createdAt])
}

model Vitals {
  id          String @id @default(uuid()) @db.Uuid
  clinicId    String @db.Uuid
  encounterId String @unique @db.Uuid

  systolicBp  Int?
  diastolicBp Int?
  bpSite      BloodPressureSite?
  bpSiteOther String?            @db.VarChar(120)

  patientPosition      PatientPosition?
  patientPositionOther String?                @db.VarChar(120)
  cuffSize             BloodPressureCuffSize?
  cuffSizeOther        String?                @db.VarChar(120)

  pulseBpm               Int?
  temperatureCelsius     Float?
  temperatureSource      TemperatureSource?
  temperatureSourceOther String?            @db.VarChar(120)
  respiratoryRate        Int?
  spo2Percent            Int?

  weightKg Float?
  heightCm Float?
  bmi      Float?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([clinicId, updatedAt])
}

model TobaccoScreening {
  id          String @id @default(uuid()) @db.Uuid
  clinicId    String @db.Uuid
  encounterId String @unique @db.Uuid

  smokingStatus          TobaccoUseStatus @default(NOT_ASSESSED)
  smokelessTobaccoStatus TobaccoUseStatus @default(NOT_ASSESSED)
  passiveExposure        ScreeningAnswer  @default(NOT_ASSESSED)
  readinessToQuit        ReadinessToQuit  @default(NOT_ASSESSED)
  counselingGiven        ScreeningAnswer  @default(NOT_ASSESSED)
  reviewedByUserId       String?          @db.Uuid
  reviewedAt             DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter  Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  clinic     Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
