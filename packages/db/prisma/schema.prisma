model Reminder {
  id String @id @default(uuid()) @db.Uuid

  // Nullable so the ledger can hold staff and system notices as well as patient
  // outreach. A global account deactivation belongs to no clinic, and a staff notice
  // belongs to no patient. The recipient_identity check constraint keeps the two
  // shapes from blurring into a row that is neither.
  clinicId        String?               @db.Uuid
  patientId       String?               @db.Uuid
  recipientType   ReminderRecipientType @default(PATIENT)
  recipientUserId String?               @db.Uuid
  portalInviteId  String?               @db.Uuid
  // An invited colleague has no User row until they first sign in, so a staff invitation is
  // addressed through the invite rather than through recipientUserId.
  staffInviteId   String?               @db.Uuid
  encounterId     String?               @db.Uuid
  appointmentId   String?               @db.Uuid

  channel     ReminderChannel
  toAddress   String          @db.VarChar(320)
  templateKey String          @db.VarChar(100)
  payloadJson String          @db.Text

  scheduledAt       DateTime
  sentAt            DateTime?
  status            ReminderStatus @default(QUEUED)
  providerMessageId String?        @db.VarChar(255)
  failureReason     String?        @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic        Clinic?              @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient       Patient?             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recipientUser User?                @relation("ReminderRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)
  portalInvite  PatientPortalInvite? @relation(fields: [portalInviteId], references: [id], onDelete: SetNull)
  staffInvite   StaffInvite?         @relation(fields: [staffInviteId], references: [id], onDelete: SetNull)
  encounter     Encounter?           @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([clinicId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([patientId])
  @@index([appointmentId])
  @@index([recipientUserId])
  @@index([portalInviteId])
  @@index([staffInviteId])
  @@index([clinicId, templateKey, createdAt])
}

model PatientAccountLink {
  id          String   @id @default(uuid()) @db.Uuid
