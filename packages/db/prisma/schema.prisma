  updatedAt        DateTime  @updatedAt

  clinic         Clinic                @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  patient        Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pharmacyRecord PatientPharmacyRecord @relation(fields: [pharmacyRecordId], references: [id], onDelete: Cascade)
  setBy          User                  @relation("PatientPharmacyPreferenceSetBy", fields: [setByUserId], references: [id])
  endedBy        User?                 @relation("PatientPharmacyPreferenceEndedBy", fields: [endedByUserId], references: [id], onDelete: SetNull)

  // A partial unique index for one open preference is created in the SQL migration.
  @@index([clinicId, patientId, effectiveFrom])
  @@index([clinicId, updatedAt, id])
  @@index([pharmacyRecordId, effectiveFrom])
  @@index([setByUserId, createdAt])
  @@index([endedByUserId, effectiveTo])
}

model SyncMutation {
  id                  String             @id @default(uuid()) @db.Uuid
  clinicId            String             @db.Uuid
  entityType          String             @db.VarChar(80)
  entityId            String             @db.VarChar(80)
  operation           SyncOperation
  idempotencyKey      String             @db.VarChar(128)
  status              SyncMutationStatus
  conflictType        String?            @db.VarChar(80)
  conflictDetailsJson String?            @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([clinicId, idempotencyKey])
  @@index([clinicId])
  @@index([clinicId, createdAt, id])
}

model Conversation {
  id       String           @id @default(uuid()) @db.Uuid
  clinicId String           @db.Uuid
  type     ConversationType @default(DIRECT)
  title    String?          @db.VarChar(200)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinic       Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([clinicId, updatedAt])
}

model ConversationParticipant {
  id             String    @id @default(uuid()) @db.Uuid
  conversationId String    @db.Uuid
  userId         String    @db.Uuid
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?
  isActive       Boolean   @default(true)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, isActive])
  @@index([conversationId])
}

model Message {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @db.Uuid
  senderUserId   String        @db.Uuid
  clinicId       String        @db.Uuid
  content        String        @db.Text
  encrypted      Boolean       @default(false)
  status         MessageStatus @default(SENT)

  createdAt DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  clinic       Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([clinicId, createdAt])
  @@index([senderUserId])
}

model PatientCodeSequence {
  year       Int @id // e.g. 2025
  lastNumber Int @default(0)
}
