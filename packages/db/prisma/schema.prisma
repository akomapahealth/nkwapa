model DiabetesScreening {
  id          String @id @default(uuid()) @db.Uuid
  clinicId    String @db.Uuid
  encounterId String @unique @db.Uuid

  glucoseMgDl  Int?
  glucoseType  GlucoseType @default(UNKNOWN)
  hba1cPercent Float?

  symptoms               DiabetesSymptom[] @default([])
  symptomsJson           String?           @db.Text
  legacySymptomsUnmapped Boolean           @default(false)

  // 1. History
  diabetesStatus       DiabetesStatus  @default(NOT_ASSESSED)
  diabetesType         DiabetesType    @default(NOT_ASSESSED)
  yearDiagnosed        Int?
  yearDiagnosedUnknown Boolean         @default(false)
  mainConcern          DiabetesConcern @default(NOT_ASSESSED)
  mainConcernOther     String?         @db.VarChar(200)

  // 2. Control. `glucoseMgDl` and `glucoseType` above already hold today's reading and its
  // timing, so unlike hypertension there is nothing to read across from another record.
  hba1cStatus           Hba1cStatus  @default(NOT_ASSESSED)
  hba1cMeasuredOn       DateTime?    @db.Date
  homeGlucoseMonitoring NkwapaAnswer @default(NOT_ASSESSED)
  homeGlucoseLowMgDl    Int?
  homeGlucoseHighMgDl   Int?

  /// Symptoms happening now, separate from the past-month `symptoms` list above.
  urgentSymptoms       DiabetesUrgentSymptom[]    @default([])
  urgentReviewRequired Boolean                    @default(false)
  urgentReviewReasons  DiabetesEscalationReason[] @default([])
  /// Derived from today's glucose and its timing. Recomputed server-side on every write.
  derivedSuspicion     DiabetesSuspicion          @default(NOT_ASSESSED)

  // 4. Nutrition. Descriptive, so JSONB.
  nutritionSchemaVersion Int   @default(1)
  nutrition              Json?

  // 5. Mental health. The two instruments are columns because their scores alert a clinician.
  phq2Interest        PhqResponse              @default(NOT_ASSESSED)
  phq2Mood            PhqResponse              @default(NOT_ASSESSED)
  /// 0-6, null until both items are answered: a partial total reads as a completed screen.
  phq2Total           Int?
  phq2Positive        Boolean                  @default(false)
  distressOverwhelmed DiabetesDistressResponse @default(NOT_ASSESSED)
  distressFailing     DiabetesDistressResponse @default(NOT_ASSESSED)
  distressPositive    Boolean                  @default(false)

  // 6. Screening status.
  eyeExam                  ScreeningCompletionStatus @default(NOT_ASSESSED)
  footExam                 ScreeningCompletionStatus @default(NOT_ASSESSED)
  kidneyTesting            ScreeningCompletionStatus @default(NOT_ASSESSED)
  /// When each screening was done, where the patient could say. Optional even when the status is
  /// COMPLETED: "sometime last year" is a real answer, and requiring a date would invite an
  /// invented one. Null therefore means "not recorded", never "not completed" -- the status
  /// column is the only thing that says whether it happened.
  eyeExamCompletedOn       DateTime?                 @db.Date
  footExamCompletedOn      DateTime?                 @db.Date
  kidneyTestingCompletedOn DateTime?                 @db.Date
  /// No date: this one asks about today by definition.
  bpCheckedToday           ScreeningCompletionStatus @default(NOT_ASSESSED)
  currentFootWound         NkwapaAnswer              @default(NOT_ASSESSED)

  // Guided plan -- volunteer.
  volunteerActionsSchemaVersion Int                    @default(1)
  volunteerActions              Json?
  clinicianReviewRequested      Boolean                @default(false)
  reviewReasons                 DiabetesReviewReason[] @default([])
  reviewReasonOther             String?                @db.VarChar(200)

  // Guided plan -- supervising clinician. The clinical specification is explicit that this part
  // shows only for the doctor; `CAREPLAN.CLINICIAN_PLAN` enforces it and the sync pull withholds it.
  clinicianPlanItems      DiabetesClinicianPlanItem[] @default([])
  clinicianPlanOther      String?                     @db.VarChar(200)
  followUpWindow          FollowUpWindow              @default(NOT_ASSESSED)
  followUpOther           String?                     @db.VarChar(120)
  followUpOwner           FollowUpOwner               @default(NOT_ASSESSED)
  clinicianComments       String?                     @db.Text
  clinicianPlanAuthorId   String?                     @db.Uuid
  clinicianPlanAuthoredAt DateTime?

  notes String? @db.Text

  collectedAt      DateTime @default(now())
  authoredByUserId String   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter           Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  clinic              Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  authoredBy          User      @relation("DiabetesScreeningAuthoredBy", fields: [authoredByUserId], references: [id])
  clinicianPlanAuthor User?     @relation("DiabetesClinicianPlanAuthor", fields: [clinicianPlanAuthorId], references: [id], onDelete: SetNull)

  @@index([clinicId, updatedAt])
  @@index([clinicId, collectedAt])
  @@index([authoredByUserId, collectedAt])
}

/// The hypertension interview (#114).
///
/// Extended rather than replaced. `classification`, `suspected` and `confirmed` predate the
/// interview and are still what the dashboard groups by, the research export reads, and the
/// patient chart renders.
model HypertensionAssessment {
  id          String @id @default(uuid()) @db.Uuid
  clinicId    String @db.Uuid
  encounterId String @unique @db.Uuid

  /// What a clinician settled on. Equals derivedClassification unless they overrode it.
  classification           HypertensionClassification @default(UNKNOWN)
  /// What the thresholds say about this encounter's vitals. Recomputed server-side on every
  /// write; a client-sent value is ignored.
  derivedClassification    HypertensionClassification @default(UNKNOWN)
  /// True once a clinician has disagreed with the derivation. Every row that existed before the
  /// interview is backfilled true, so the new rule can never silently rewrite a finding somebody
  /// entered by hand.
  classificationOverridden Boolean                    @default(false)
  suspected                Boolean                    @default(false)
  confirmed                Boolean                    @default(false)

  // 1. History
  hypertensionStatus      HypertensionStatus  @default(NOT_ASSESSED)
  yearDiagnosed           Int?
  yearDiagnosedUnknown    Boolean             @default(false)
  mainConcern             HypertensionConcern @default(NOT_ASSESSED)
  mainConcernOther        String?             @db.VarChar(200)
  usualCareFacility       String?             @db.VarChar(200)
  usualCareFacilityStatus FacilityKnownStatus @default(NOT_ASSESSED)

  // 2. Blood-pressure control. Today's reading is NOT copied here -- it is read from Vitals, so
  // one encounter cannot hold two disagreeing answers to "what was the blood pressure today".
  repeatPerformed     BpRepeatStatus         @default(NOT_ASSESSED)
  repeatSystolicBp    Int?
  repeatDiastolicBp   Int?
  repeatPosition      PatientPosition?
  repeatCuffSize      BloodPressureCuffSize?
  repeatMeasuredAt    DateTime?
  /// Whether the rest-and-repeat prompt was surfaced, so an audit can tell a volunteer who
  /// ignored it from one who was never asked.
  repeatPromptShown   Boolean                @default(false)
  homeMonitorStatus   HomeBpMonitorStatus    @default(NOT_ASSESSED)
  homeCheckFrequency  HomeBpCheckFrequency   @default(NOT_ASSESSED)
  homeSystolicAvg     Int?
  homeDiastolicAvg    Int?
  homeReadingsUnknown Boolean                @default(false)
  homeReadingSource   HomeBpSource           @default(NOT_ASSESSED)

  // 3. Symptoms, and the escalation derived from them plus the reading.
  currentSymptoms      HypertensionSymptom[]          @default([])
  urgentReviewRequired Boolean                        @default(false)
  urgentReviewReasons  HypertensionEscalationReason[] @default([])

  // 4. Adherence support. The medications themselves live in the reconciled patient list; only
  // the per-visit observations are ours, in EncounterMedicationAdherence.
  medicationReminderStrategies MedicationReminderStrategy[] @default([])
  reminderStrategyOther        String?                      @db.VarChar(200)

  // 5. Possible contributors.
  contributingSubstances BpAffectingSubstance[] @default([])
  substanceSchemaVersion Int                    @default(1)
  substanceDetails       Json?

  // 6. Nutrition, activity and alcohol. Descriptive, so JSONB. Tobacco is deliberately absent:
  // TobaccoScreening already carries it for this encounter.
  lifestyleSchemaVersion Int   @default(1)
  lifestyle              Json?

  // 7. Relevant history.
  relevantConditions CardiometabolicCondition[] @default([])
  pregnantNow        NkwapaAnswer               @default(NOT_ASSESSED)
  planningPregnancy  PregnancyPlanningAnswer    @default(NOT_ASSESSED)

  // 8. Screening status.
  kidneyFunctionTesting            ScreeningCompletionStatus @default(NOT_ASSESSED)
  urineProteinTesting              ScreeningCompletionStatus @default(NOT_ASSESSED)
  cholesterolTesting               ScreeningCompletionStatus @default(NOT_ASSESSED)
  ecgCompleted                     ScreeningCompletionStatus @default(NOT_ASSESSED)
  /// See the note on DiabetesScreening: optional even when COMPLETED, so null is "not recorded".
  kidneyFunctionTestingCompletedOn DateTime?                 @db.Date
  urineProteinTestingCompletedOn   DateTime?                 @db.Date
  cholesterolTestingCompletedOn    DateTime?                 @db.Date
  ecgCompletedOn                   DateTime?                 @db.Date
  statinUse                        MedicationUseStatus       @default(NOT_ASSESSED)
  aspirinUse                       MedicationUseStatus       @default(NOT_ASSESSED)

  // Guided plan -- volunteer.
  volunteerActionsSchemaVersion Int                        @default(1)
  volunteerActions              Json?
  /// Lifted out of the volunteer-actions payload because it escalates a patient. Everything else
  /// in that checklist is descriptive; where "descriptive" and "decides something" collide, the
  /// column wins.
  clinicianReviewRequested      Boolean                    @default(false)
  reviewReasons                 HypertensionReviewReason[] @default([])
  reviewReasonOther             String?                    @db.VarChar(200)

  // Guided plan -- supervising clinician. Gated on CAREPLAN.CLINICIAN_PLAN, refused by the API
  // for a non-doctor, and omitted from the sync pull so a volunteer's device never caches it.
  clinicianPlanItems      HypertensionClinicianPlanItem[] @default([])
  clinicianPlanOther      String?                         @db.VarChar(200)
  bpGoalSystolic          Int?
  bpGoalDiastolic         Int?
  followUpWindow          FollowUpWindow                  @default(NOT_ASSESSED)
  followUpOther           String?                         @db.VarChar(120)
  followUpOwner           FollowUpOwner                   @default(NOT_ASSESSED)
  clinicianComments       String?                         @db.Text
  clinicianPlanAuthorId   String?                         @db.Uuid
  clinicianPlanAuthoredAt DateTime?

  notes String? @db.Text

  // Provenance, matching DiabetesScreening. Its absence was the clearest half of the asymmetry
  // between the two conditions.
  collectedAt      DateTime @default(now())
  authoredByUserId String   @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  encounter           Encounter @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  clinic              Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  authoredBy          User      @relation("HypertensionAssessmentAuthoredBy", fields: [authoredByUserId], references: [id])
  clinicianPlanAuthor User?     @relation("HypertensionClinicianPlanAuthor", fields: [clinicianPlanAuthorId], references: [id], onDelete: SetNull)

  @@index([clinicId, updatedAt])
  @@index([clinicId, collectedAt])
  @@index([authoredByUserId, collectedAt])
}

/// What a volunteer observed about one reconciled medication at one visit.
///
/// Deliberately not a medication list. `PatientMedicationRevision` is the patient's medication of
/// record and is append-on-change; writing "took it today" as a revision would fill that history
/// with non-changes and corrupt `lastReconciledAt`. These are observations about a medication, not
/// properties of it.
model EncounterMedicationAdherence {
  id          String                     @id @default(uuid()) @db.Uuid
  clinicId    String                     @db.Uuid
  encounterId String                     @db.Uuid
  context     MedicationAdherenceContext

  medicationRecordId String @db.Uuid
  /// The revision the volunteer had on screen. Without it, a later reconciliation would silently
  /// re-point a recorded observation at a different dose.
  observedRevisionId String @db.Uuid

  // Hypertension asks these two; diabetes asks takingAsPrescribed. A CHECK constraint keeps the
  // other condition's columns at NOT_ASSESSED, so "not applicable here" is represented rather
  // than implied by a null.
  tookToday          NkwapaAnswer             @default(NOT_ASSESSED)
  dosesMissed7d      MedicationDosesMissed    @default(NOT_ASSESSED)
  takingAsPrescribed MedicationAdherenceLevel @default(NOT_ASSESSED)

  supplyRemaining MedicationSupplyStatus @default(NOT_ASSESSED)
  problems        MedicationProblem[]    @default([])
  problemsOther   String?                @db.VarChar(200)

  authoredByUserId String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

