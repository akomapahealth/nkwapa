model PatientPortalInvite {
  id              String                    @id @default(uuid()) @db.Uuid
  patientId       String                    @db.Uuid
  clinicId        String                    @db.Uuid
  status          PatientPortalInviteStatus @default(PENDING)
  email           String?                   @db.VarChar(320)
  phoneE164       String?                   @db.VarChar(32)
  createdByUserId String                    @db.Uuid
  claimedByUserId String?                   @db.Uuid
  claimedAt       DateTime?
  cancelledAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  // Identity provisioning, recorded so the chart can answer "can this patient actually act
  // on the email we sent?" on every page load rather than only in the response to the
  // click that sent it.
  identityStatus        PortalInviteIdentityStatus @default(NOT_REQUESTED)
  // Kept for support: it is the only way to tie an invite to the Keycloak account without
  // searching by email, which is the thing we most want to avoid logging.
  keycloakUserId        String?                    @db.VarChar(255)
  identityProvisionedAt DateTime?
  /// A stable code such as KEYCLOAK_ADMIN_TIMEOUT. Never a patient-identifying string.
  identityFailureReason String?                    @db.VarChar(255)

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  clinic    Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy User       @relation("PatientPortalInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  claimedBy User?      @relation("PatientPortalInviteClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([patientId, status])
  @@index([clinicId, status, createdAt])
  @@index([email, status])
  @@index([phoneE164, status])
  // The expiry sweep's only query: overdue pending rows, oldest first. Without this it
  // is a sequential scan over every invite the deployment has ever issued.
  @@index([status, expiresAt])
}

/// An invitation for someone to join a clinic's staff in a given role.
///
/// Deliberately not the patient invite with a role column. A patient invite grants one record
/// the invitee must still identify with a patient code and date of birth; this grants a role
/// over other people's clinical data, with possession of the inbox as the only proof. The
/// controls that difference demands (a role ceiling, a short expiry, refusing shared inboxes)
/// live in apps/api/src/common/staff-invite-lifecycle.ts.
model StaffInvite {
  id                String            @id @default(uuid()) @db.Uuid
  clinicId          String            @db.Uuid
  /// Stored lower-cased. Matched against User.email, which only holds a verified address.
  email             String            @db.VarChar(320)
  role              UserRole
  status            StaffInviteStatus @default(PENDING)
  createdByUserId   String            @db.Uuid
  acceptedByUserId  String?           @db.Uuid
  acceptedAt        DateTime?
  cancelledByUserId String?           @db.Uuid
  cancelledAt       DateTime?
  /// Never null: unlike the patient invite, this table has no rows from before expiry existed.
  expiresAt         DateTime
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  // Identity provisioning, the same shape PatientPortalInvite records, so the admin view can
  // say whether the invitee can act on the email rather than only whether it was sent.
  identityStatus        PortalInviteIdentityStatus @default(NOT_REQUESTED)
  keycloakUserId        String?                    @db.VarChar(255)
  identityProvisionedAt DateTime?
  /// A stable code such as KEYCLOAK_ADMIN_TIMEOUT. Never an address.
  identityFailureReason String?                    @db.VarChar(255)

  clinic      Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  createdBy   User       @relation("StaffInviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  acceptedBy  User?      @relation("StaffInviteAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  cancelledBy User?      @relation("StaffInviteCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: SetNull)
  reminders   Reminder[]

  // "Invitations for this clinic, newest first", the admin listing.
  @@index([clinicId, status, createdAt])
  // "What is this signed-in person invited to", read by whoami on every bootstrap.
  @@index([email, status])
  // The expiry sweep.
  @@index([status, expiresAt])
}

