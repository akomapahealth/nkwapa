# apps/api/.env.example

NODE_ENV=development
PORT=4000
# Web app origin for CORS (default: http://localhost:3000)
# CORS_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://nkwapa:nkwapa@localhost:5433/nkwapa
REDIS_URL=redis://localhost:6379

# Keycloak / OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/nkwapa
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/nkwapa/protocol/openid-connect/certs
# Optional: enforce token audience. If you get 401, comment out or remove KEYCLOAK_AUDIENCE.
# KEYCLOAK_AUDIENCE=nkwapa-web

# Seed (packages/db): create SYSTEM_ADMIN by Keycloak sub
# Obtain sub: login to Keycloak, decode JWT, or Admin Console → Users → select user → ID
# SEED_SYSTEM_ADMIN_SUB=

# Security
PII_ENCRYPTION_KEY_BASE64=
NATIONAL_ID_PEPPER=
# 32-byte hex for national ID encryption (generate: openssl rand -hex 32)
NATIONAL_ID_ENCRYPTION_KEY=

# Ghana phone normalization default (v1)
DEFAULT_COUNTRY_CODE=GH

# Email Provider: "fake" (default, console logging) or "nodemailer" (real SMTP)
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
