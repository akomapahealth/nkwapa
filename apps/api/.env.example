# apps/api/.env.example
# For hosted staging/production values, use deploy/env/staging.api.env.example and
# deploy/env/production.api.env.example.

NODE_ENV=development
PORT=4000
# Exact frontend origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://nkwapa:nkwapa@localhost:5433/nkwapa
REDIS_URL=redis://localhost:6379

# Keycloak / OIDC
KEYCLOAK_ISSUER=http://localhost:8080/realms/nkwapa
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/nkwapa/protocol/openid-connect/certs
# Optional: enforce token audience. If you get 401, comment out or remove KEYCLOAK_AUDIENCE.
# KEYCLOAK_AUDIENCE=nkwapa-web

# Seed (packages/db): create SYSTEM_ADMIN by Keycloak sub
# Obtain sub: login to Keycloak, decode JWT, or Admin Console → Users → select user → ID
# SEED_SYSTEM_ADMIN_SUB=
# Deterministic multi-role staff user for Playwright smoke coverage
# SEED_E2E_STAFF_SUB=00000000-0000-4000-8000-000000000042
# SEED_E2E_STAFF_NAME=E2E Staff
# SEED_E2E_STAFF_EMAIL=e2e.staff@nkwapa.local

# Security
PII_ENCRYPTION_KEY_BASE64=
NATIONAL_ID_PEPPER=
# 32-byte hex for national ID encryption (generate: openssl rand -hex 32)
NATIONAL_ID_ENCRYPTION_KEY=

# Ghana phone normalization default (v1)
DEFAULT_COUNTRY_CODE=GH

# Email delivery (application mail: portal invites, reminders, lifecycle notices).
# This is NOT Keycloak's SMTP. Keycloak sends verify-email and password resets using the
# separate KC_SMTP_* settings on the Keycloak service; the two are configured independently.
# "fake" (default) logs message sizes instead of sending. "nodemailer" sends over SMTP.
EMAIL_PROVIDER=fake
SMTP_HOST=
SMTP_PORT=587
# Credentials are optional, but only as a pair. Leave both blank for an unauthenticated
# relay such as the local Mailpit; setting only one is reported as a misconfiguration.
SMTP_USER=
SMTP_PASS=
# Implicit TLS is assumed on port 465 and STARTTLS elsewhere. Set to override.
SMTP_SECURE=
EMAIL_FROM=info@akomapa.org
EMAIL_REPLY_TO=
# Absolute origin used to build links in outbound mail. Links are omitted when unset.
APP_PUBLIC_URL=http://localhost:3000

# SMS Provider: "fake" (default, console logging) or "twilio" (real SMS)
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

# Research export directory
EXPORT_DIR=./data/exports

# Observability
SENTRY_DSN=
