# apps/web/.env.example
# For hosted staging/production values, use deploy/env/staging.web.env.example and
# deploy/env/production.web.env.example.

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Keycloak client config (web)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=nkwapa
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nkwapa-web

# v1: phone input selector locked to Ghana
NEXT_PUBLIC_DEFAULT_COUNTRY=GH
NEXT_PUBLIC_LOCK_COUNTRY_SELECTOR=true

# Playwright smoke user defaults
# E2E_STAFF_USERNAME=e2e.staff
# E2E_STAFF_PASSWORD=NkwapaE2E!23

# Consent-gated analytics (PostHog). The cookie banner appears only when this is 'true', and
# nothing loads until a visitor accepts. The project key is public (phc_...), not a secret.
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Observability
NEXT_PUBLIC_SENTRY_DSN=

# Background Web Push (#250): the PUBLIC half of the API's VAPID key pair
# (WEB_PUSH_VAPID_PUBLIC_KEY on the API). Blank keeps background push off.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
