# apps/web/.env.example

NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# Keycloak client config (web)
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=nkwapa
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=nkwapa-web

# v1: phone input selector locked to Ghana
NEXT_PUBLIC_DEFAULT_COUNTRY=GH
NEXT_PUBLIC_LOCK_COUNTRY_SELECTOR=true

# Landing page analytics (GA4, PostHog, etc.)
# NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Observability
NEXT_PUBLIC_SENTRY_DSN=
