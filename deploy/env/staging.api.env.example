# Render service: nkwapa-api-staging.onrender.com

# ---------------------------------------------------------------------------------------------
# NEW IN THIS RELEASE (release/dev, October 2026). Add these to the service before deploying:
#   CLINICIAN_PLAN_SEAL_PRIVATE_KEY   NEW. Lets a doctor record the clinician plan offline (#131).
#   CLINICIAN_PLAN_SEAL_KEY_ID        NEW. Any label for that key, e.g. 2026-10.
# Both are optional: without them the API starts and the clinician plan stays online-only.
#
# Not new, but check it is on: FEATURE_STATION_WORKFLOW_ENABLED=true (with the web flag)
# is what shows the Eye station, manager assign, station capacity and station flow metrics.
# Everything else this release ships (staff group chat, staff activity, the sync fixes) needs
# no new variable.
# ---------------------------------------------------------------------------------------------

NODE_ENV=production
PORT=10000

DATABASE_URL=postgresql://<neon-user>:<neon-password>@<neon-host>/<database>?sslmode=require
REDIS_URL=rediss://default:<upstash-password>@<upstash-host>:6379

CORS_ALLOWED_ORIGINS=https://staging.nkwapa.app

FEATURE_MEDICAL_HISTORY_ENABLED=false
FEATURE_MEDICATION_RECONCILIATION_ENABLED=false
FEATURE_CLINICAL_NOTES_ENABLED=false
# The guided hypertension and diabetes interviews. Off until the clinic-session validation
# passes. The API flag gates the hypertension REST writes and the clinician-plan routes. Diabetes
# list and upsert, and hypertension history, stay available so the chart can always show them.
FEATURE_GUIDED_CHRONIC_TABS_ENABLED=false
# Station-based patient flow (#167). While on, the station line replaces the legacy patient
# assignment; managers assign from the station board instead. Also gates the Eye station,
# station capacity and setup, and station flow metrics.
FEATURE_STATION_WORKFLOW_ENABLED=false

# Product and operational telemetry (#29). Counts and failure codes only, never personal data;
# see docs/specs/15_TELEMETRY_AND_METRICS.md. Set to false to stop recording entirely.
TELEMETRY_ENABLED=true
# Days of telemetry kept before the daily purge deletes it. Bounded to 7-730.
TELEMETRY_RETENTION_DAYS=180

KEYCLOAK_ISSUER=https://nkwapa-auth-staging.onrender.com/realms/nkwapa
KEYCLOAK_JWKS_URI=https://nkwapa-auth-staging.onrender.com/realms/nkwapa/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=nkwapa-web

# Patient identity provisioning. Server-side only -- these must never appear in any
# NEXT_PUBLIC_ variable or reach the browser. KEYCLOAK_ADMIN_CLIENT_SECRET must match
# the value given to the Keycloak service.
KEYCLOAK_ADMIN_BASE_URL=https://nkwapa-auth-staging.onrender.com
KEYCLOAK_REALM=nkwapa
KEYCLOAK_ADMIN_CLIENT_ID=nkwapa-api
KEYCLOAK_ADMIN_CLIENT_SECRET=replace_me_with_a_generated_secret

PII_ENCRYPTION_KEY_BASE64=
NATIONAL_ID_PEPPER=
NATIONAL_ID_ENCRYPTION_KEY=
RESEARCH_HMAC_KEY=
RESEARCH_HMAC_KEY_ID=research-hmac-v1

DEFAULT_COUNTRY_CODE=GH

# Email delivery (application mail: portal invites, reminders, lifecycle notices).
# This is NOT Keycloak's SMTP. Keycloak sends verify-email and password resets using the
# separate KC_SMTP_* settings on the Keycloak service; the two are configured independently.
# "fake" logs message sizes instead of sending. "nodemailer" sends over SMTP. This file
# documents a deployment that actually sends, so it is set to nodemailer: leaving it on
# fake in a deployed environment looks identical to working email until someone checks
# an inbox.
EMAIL_PROVIDER=nodemailer
SMTP_HOST=smtp.resend.com
# Port 2587 is deliberate, not a typo. Render blocks outbound traffic to the standard SMTP
# ports (25, 465 and 587) on free web services, and blocks 25 on every tier. The firewall
# drops the packets rather than refusing them, so a service pointed at 587 does not fail --
# it hangs until it times out. Resend also answers on 2587 (STARTTLS) and 2465 (implicit
# TLS) for exactly this situation. On a paid instance 465 and 587 work again.
SMTP_PORT=2587
# Credentials are optional, but only as a pair. Leave both blank for an unauthenticated
# relay such as the local Mailpit; setting only one is reported as a misconfiguration.
# For Resend the username is the literal string "resend" and the password is the API key.
SMTP_USER=resend
SMTP_PASS=<resend-api-key>
# Implicit TLS is assumed on ports 465 and 2465, STARTTLS elsewhere. Set to override.
SMTP_SECURE=
# Must match KC_SMTP_FROM on the Keycloak service. See the note there. Set the bare
# address here; the display name belongs in EMAIL_FROM_NAME.
EMAIL_FROM=no-reply@akomapa.org
# Must match KC_SMTP_FROM_DISPLAY_NAME on the Keycloak service, per environment. A patient
# receives the invite from here and the account-setup link from Keycloak within moments of
# each other. The display name is the most visible thing in an inbox list -- more visible
# than the address, which most clients hide -- so two different names across that pair is
# exactly what makes the second message read as a phishing attempt.
EMAIL_FROM_NAME=Nkwapa Staging
EMAIL_REPLY_TO=info@akomapa.org
# Absolute origin used to build links in outbound mail. Links are omitted when unset.
APP_PUBLIC_URL=

SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=

EXPORT_DIR=/tmp/exports
RESEARCH_EXPORT_DIR=/tmp/research-exports
RESEARCH_EXPORT_RETENTION_DAYS=30
RESEARCH_GITHUB_REPO_OWNER=
RESEARCH_GITHUB_REPO_NAME=
RESEARCH_GITHUB_REPO_BRANCH=main
RESEARCH_GITHUB_REPO_BASE_PATH=clinics
RESEARCH_GITHUB_TOKEN=
RESEARCH_GITHUB_MAX_FILE_BYTES=99614720
RESEARCH_GITHUB_MAX_TOTAL_BYTES=262144000

SENTRY_DSN=<optional-for-later>

# NEW IN THIS RELEASE: the two CLINICIAN_PLAN_SEAL_* lines below.
# Sealing a clinician plan a doctor queues offline (#131). Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:3072 | base64 | tr -d '\n'
# Without a key the clinician plan stays online-only. On rotation, move the current pair to the
# PREVIOUS_* variables so plans already queued against it still open.
CLINICIAN_PLAN_SEAL_PRIVATE_KEY=<base64-encoded-pkcs8-pem>
CLINICIAN_PLAN_SEAL_KEY_ID=<e.g. 2026-10>
# CLINICIAN_PLAN_SEAL_PREVIOUS_PRIVATE_KEY=
# CLINICIAN_PLAN_SEAL_PREVIOUS_KEY_ID=
