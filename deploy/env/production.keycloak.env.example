# Render service: auth.nkwapa.app

KC_DB=postgres
# Do not paste Neon's postgresql://<user>:<password>@<host>/<db> app URL here.
# Keycloak needs a JDBC URL with credentials split into KC_DB_USERNAME/KC_DB_PASSWORD.
KC_DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
KC_DB_USERNAME=<neon-user>
KC_DB_PASSWORD=<neon-password>
# Optional cleaner setup: create this schema first, then uncomment.
# KC_DB_SCHEMA=keycloak

KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME=https://auth.nkwapa.app
KC_SSL_REQUIRED=external
# Substituted into the nkwapa-api client when the realm is imported. Must match the
# KEYCLOAK_ADMIN_CLIENT_SECRET set on the API service. Generate a distinct value per
# environment and set it as a secret, not in source control.
KEYCLOAK_ADMIN_CLIENT_SECRET=replace_me_with_a_generated_secret

KC_BOOTSTRAP_ADMIN_USERNAME=<bootstrap-admin-username>
KC_BOOTSTRAP_ADMIN_PASSWORD=<bootstrap-admin-password>

# Required for forgot password and email verification.
KC_SMTP_HOST=<smtp-host>
KC_SMTP_PORT=587
# A patient receives two emails: this one carries the account-setup link, and the API sends
# the invitation that names it. They must come from the same authenticated domain, or the
# pairing that stops them reading as a phishing attempt does not hold -- and the one carrying
# the link is the one that gets spam-foldered.
#
# Leave KC_SMTP_ENVELOPE_FROM empty unless you know you need it. SPF is evaluated against the
# ENVELOPE sender, not the header From, and a transactional provider sets an envelope on a
# subdomain it controls and has already published SPF for. Forcing the envelope onto the bare
# domain hands SPF a record that does not list the provider, turning a pass into a softfail.
# DKIM still carries DMARC, so it fails quietly, which is the worst way for it to fail.
KC_SMTP_FROM=no-reply@akomapa.org
KC_SMTP_FROM_DISPLAY_NAME=Nkwapa
KC_SMTP_REPLY_TO=info@akomapa.org
KC_SMTP_REPLY_TO_DISPLAY_NAME=Nkwapa Support
KC_SMTP_ENVELOPE_FROM=
KC_SMTP_AUTH=true
KC_SMTP_STARTTLS=true
KC_SMTP_SSL=false
KC_SMTP_USER=<smtp-username>
KC_SMTP_PASSWORD=<smtp-password>
