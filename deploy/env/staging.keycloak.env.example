# Render service: nkwapa-auth-staging.onrender.com

KC_DB=postgres
# Do not paste Neon's postgresql://<user>:<password>@<host>/<db> app URL here.
# Keycloak needs a JDBC URL with credentials split into KC_DB_USERNAME/KC_DB_PASSWORD.
KC_DB_URL=jdbc:postgresql://<neon-host>/<database>?sslmode=require
KC_DB_USERNAME=<neon-user>
KC_DB_PASSWORD=<neon-password>
# Optional cleaner setup: create this schema first, then uncomment.
# KC_DB_SCHEMA=keycloak

KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HOSTNAME=https://nkwapa-auth-staging.onrender.com

KEYCLOAK_ADMIN=<bootstrap-admin-username>
KEYCLOAK_ADMIN_PASSWORD=<bootstrap-admin-password>
