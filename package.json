{
  "name": "nkwapa",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "prisma generate --schema=packages/db/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=packages/db/prisma/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema=packages/db/prisma/schema.prisma",
    "db:seed": "ts-node --transpile-only packages/db/prisma/seed.ts",
    "db:assign-system-admin": "ts-node --transpile-only packages/db/prisma/assign-system-admin.ts",
    "keycloak:validate-realm": "node scripts/validate-keycloak-realm.mjs",
    "security:scan": "node scripts/check-secrets.mjs",
    "security:scan:staged": "node scripts/check-secrets.mjs --staged",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspace=@nkwapa/web",
    "e2e:keycloak-user": "node scripts/create-keycloak-e2e-user.mjs",
    "build": "npm run build --workspaces --if-present",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "npm run db:generate"
  },
  "devDependencies": {
    "@nestjs/platform-express": "^11.1.24",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "next": "16.3.0-canary.32",
    "postcss": "8.5.15",
    "prettier": "^3.3.3",
    "prisma": "7.5.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "7.5.0"
  },
  "overrides": {
    "@hono/node-server": "2.0.4",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "@tootallnate/once": "3.0.1",
    "brace-expansion": "1.1.15",
    "anymatch": {
      "picomatch": "2.3.2"
    },
    "cosmiconfig": {
      "yaml": "1.10.3"
    },
    "effect": "3.20.0",
    "file-type": "21.3.4",
    "jest-util": {
      "picomatch": "2.3.2"
    },
    "hono": "4.12.18",
    "lodash": "4.18.1",
    "micromatch": {
      "picomatch": "2.3.2"
    },
    "next": {
      ".": "16.3.0-canary.32",
      "postcss": "8.5.10"
    },
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "readdirp": {
      "picomatch": "2.3.2"
    },
    "rxjs": "7.8.2",
    "socket.io-adapter": {
      "ws": "8.21.0"
    },
    "tailwindcss": {
      "picomatch": "2.3.2"
    },
    "webpack": "5.107.2",
    "ws": "8.21.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
